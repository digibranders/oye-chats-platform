# API Backend URL (optional - defaults to http://localhost:8000)
# VITE_API_URL=http://localhost:8000

# Sentry Error Tracking (optional - leave blank to disable)
# Sentry Error Tracking (optional — leave blank to disable)
# Events are only sent from production builds served off a non-localhost host,
# so a DSN here is inert during local development and `vite preview`.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
