# API Backend URL (optional — defaults to http://localhost:8000)
# VITE_API_URL=http://localhost:8000

# Sentry Error Tracking (optional — leave blank to disable)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Guided Build Studio onboarding: route new signups into /build. Off by default; enable in .env.local for local testing.
VITE_STUDIO_ENABLED=false
