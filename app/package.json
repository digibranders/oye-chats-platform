{
  "name": "oyechats-admin",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e:build": "VITE_API_URL=http://oyechats-admin-e2e.test vite build",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@sentry/react": "^10.45.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0-beta.13",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  },
  "size-limit": [
    {
      "name": "Main app chunk (initial load, English path)",
      "path": "dist/assets/index-*.js",
      "limit": "615 KB",
      "gzip": true
    },
    {
      "name": "Launch Studio (lazy, onboarding only)",
      "path": "dist/assets/LaunchStudio-*.js",
      "limit": "18 KB",
      "gzip": true
    },
    {
      "name": "Hindi dictionary (lazy, non-English only)",
      "path": "dist/assets/hi-*.js",
      "limit": "40 KB",
      "gzip": true
    }
  ]
}
