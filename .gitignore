# Documents (Keep folder structure, but ignore content)
api/documents/*
api/archive/*
!api/documents/.gitkeep
!api/archive/.gitkeep

# Database / Secrets
.env
*.db
*.sqlite

# Python
__pycache__/
*.py[cod]
*$py.class
.venv
.venv.nosync/
env/
venv/
ENV/
.coverage
htmlcov/

# Distribution / packaging
dist/
node_modules/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*

# Editor / System
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
brain/
.claude/

widget/.wrangler/

# Brevo template backups (created by scripts/upload_brevo_templates.py)
api/emails/.backup/

# Email rendering preview (generated artifact, not source-of-truth)
api/emails/preview/

# Answer-quality eval output (report.json holds every answer of a run verbatim,
# so a run against a production bot is customer data. Regenerated per run.)
api/eval-report/

# Personal local-dev launcher (API + ARQ worker side-by-side, env overrides)
api/dev.sh

# Machine-specific uv config (points to local conda env path)
api/uv.toml

# Git worktrees (local isolated workspaces)
.worktrees/

# Superpowers / brainstorm skill scratch output (never commit)
.superpowers/

# /graphify knowledge-graph output — generated, ~29MB, stale the moment code changes
graphify-out/

# Redis persistence dump — runtime artifact written by a local redis-server
dump.rdb

# Strix pentest scan output (generated, may contain live tokens/creds)
strix_runs/

# Edge-case evaluation suite output and local bot list (bot keys and every
# reply/knowledge-base export from a real run are customer data)
api/eval/edge_suite/out/
api/eval/edge_suite/bots.local.json
