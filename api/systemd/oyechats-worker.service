# OyeChats Background Worker — systemd service (ARQ)
#
# Install:
#   sudo cp oyechats-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oyechats-worker
#
# Logs:
#   journalctl -u oyechats-worker -f

[Unit]
Description=OyeChats Background Worker (ARQ)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple

# Non-root service account (audit F06 — completed).
# MIGRATION PREREQUISITE: run api/scripts/migrate-to-nonroot.sh on the droplet
# ONCE before this unit is first installed. It creates the `oyechats` system
# user/group, fixes permissions (.env group-read, documents/ + archive/
# ownership, /var/cache/oyechats), installs these units and restarts the
# services. Installing this unit before the user exists makes the service fail
# to start ("Failed to determine user credentials").
User=oyechats
Group=oyechats
WorkingDirectory=/opt/oyechats/platform/api
EnvironmentFile=/opt/oyechats/platform/api/.env
# Worker-specific DB pool (audit F30): the worker shares api/.env with the API
# but is a SEPARATE process with its own pool. Size it to WORKER_MAX_JOBS (~5)
# rather than inheriting the API's pool assumptions, so API + worker together
# stay under the server's max_connections. These Environment= lines override the
# shared EnvironmentFile for this unit only.
Environment=DB_POOL_SIZE=5
Environment=DB_MAX_OVERFLOW=5
# Exec the venv interpreter directly instead of `/root/.local/bin/uv run`:
# uv lives under /root (unreachable with ProtectHome=true) and `uv run` may
# try to re-sync the venv, which the unprivileged user must not (and cannot)
# write. The deploy workflow's root-run `uv sync` keeps the venv current;
# the arq target is unchanged from the previous unit.
ExecStart=/opt/oyechats/platform/api/.venv/bin/python -m arq app.worker.settings.WorkerSettings

# The service account has no usable home (created with -d /nonexistent), so
# point HOME and the XDG cache at the systemd-managed cache directory:
# fontconfig (WeasyPrint invoice-PDF rendering runs in THIS process) and
# anything else calling expanduser("~") gets a persistent writable location.
# CacheDirectory= makes systemd create /var/cache/oyechats owned by the
# service user and keeps it writable under ProtectSystem=strict.
CacheDirectory=oyechats
Environment=HOME=/var/cache/oyechats
Environment=XDG_CACHE_HOME=/var/cache/oyechats

# Auto-restart on crash with 5s backoff
Restart=always
RestartSec=5

# Resource limits
LimitNOFILE=65535

# ── Security hardening (audit F06 — service is now non-root) ────────────────
# ProtectSystem upgraded full → strict: `full` only remounts /usr, /boot and
# /etc read-only, leaving /opt — i.e. the code checkout itself — writable, so
# a compromised process could rewrite its own source. `strict` mounts the
# ENTIRE filesystem read-only except the explicit allow-list below. Complete
# inventory of runtime write locations (invoice PDFs are rendered to bytes and
# uploaded straight to Cloudflare R2 — no local PDF files):
#   documents/ + archive/   tenant uploads ingested by task_ingest_documents
#                           and their processed/quarantined copies
#                           (app/config.py DOCUMENTS_DIR/ARCHIVE_DIR,
#                           relative to WorkingDirectory)
#   /tmp                    WeasyPrint scratch + flashrank cache (PrivateTmp —
#                           compatible with WeasyPrint/pango: private but
#                           writable)
#   /var/cache/oyechats     CacheDirectory= above (auto-whitelisted)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/oyechats/platform/api/documents
ReadWritePaths=/opt/oyechats/platform/api/archive
# Nothing under /root or /home is needed anymore now that ExecStart no longer
# goes through /root/.local/bin/uv.
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
# AF_NETLINK stays allowed: glibc getaddrinfo uses rtnetlink for
# AI_ADDRCONFIG — dropping it can silently break DNS resolution.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# MemoryDenyWriteExecute deliberately NOT set: cffi (WeasyPrint's FFI layer)
# needs writable+executable pages for its callback trampolines.
# Keep tenant uploads out of world-readable: files land 0640 / dirs 0750.
UMask=0027

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oyechats-worker

[Install]
WantedBy=multi-user.target
