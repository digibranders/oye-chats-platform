# OyeChats Background Worker — systemd service (ARQ)
#
# Install:
#   sudo cp oyechats-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oyechats-worker
#
# Logs:
#   journalctl -u oyechats-worker -f

[Unit]
Description=OyeChats Background Worker (ARQ)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/oyechats/platform/api
EnvironmentFile=/opt/oyechats/platform/api/.env
ExecStart=/root/.local/bin/uv run arq app.worker.settings.WorkerSettings

# Auto-restart on crash with 5s backoff
Restart=always
RestartSec=5

# Resource limits
LimitNOFILE=65535

# Security hardening (audit F06). REMAINING STEP: drop from root to a dedicated
# unprivileged `oyechats` user — do this on staging first (also requires making
# `uv` runnable by that user and chowning /opt/oyechats/platform + api/.env +
# the documents dir where invoice PDFs are written). The directives below are
# safe with the current root + /root/.local/bin/uv + /opt layout. PrivateTmp is
# compatible with WeasyPrint/pango (they use a private /tmp, still writable).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oyechats-worker

[Install]
WantedBy=multi-user.target
